{
  "name": "openapi-template",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "run-s lint:check lint:oxlint lint:oxfmt lint:textlint lint:redocly",
    "lint:check": "npm run check",
    "lint:oxlint": "oxlint",
    "lint:oxfmt": "oxfmt --check",
    "lint:textlint": "textlint . --ignore-path ./.gitignore",
    "lint:redocly": "redocly lint --config ./redocly.yaml",
    "fix": "run-s --continue-on-error sort fix:textlint fix:oxlint fix:oxfmt lint",
    "fix:oxlint": "oxlint --fix",
    "fix:oxfmt": "oxfmt",
    "fix:textlint": "textlint . --fix --ignore-path ./.gitignore",
    "build": "run-s build:clean build:bundle build:build",
    "build:clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build:bundle": "redocly bundle ./api.yaml --config ./redocly.yaml --ext yaml --output ./dist/api.yaml",
    "build:build": "node ./bin/build.ts ./dist",
    "sort": "node ./bin/sort.ts",
    "list": "node ./bin/list.ts",
    "search": "node ./bin/search.ts",
    "start": "http-server ./dist -p 4000 -a 0.0.0.0 -c-1",
    "dev": "http-server ./ -p 4000 -a 0.0.0.0 -c-1"
  },
  "devDependencies": {
    "@ansanloms/redocly-plugin-inline-examples": "github:ansanloms/redocly-plugin-inline-examples#0.1.0",
    "@ansanloms/textlint-plugin-yaml-keys": "github:ansanloms/textlint-plugin-yaml-keys#0.1.0",
    "@ansanloms/textlint-rule-preset-ansanloms": "github:ansanloms/textlint-rule-preset-ansanloms#0.1.0",
    "@redocly/cli": "2.75.0",
    "@stoplight/elements": "9.0.29",
    "@types/node": "26.6.6",
    "cli-table3": "0.6.5",
    "gunshi": "0.37.3",
    "http-server": "14.1.1",
    "npm-run-all2": "9.0.4",
    "openapi-types": "12.1.3",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "picocolors": "1.1.1",
    "textlint": "15.8.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
